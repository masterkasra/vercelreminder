# Copy to .env.local for `vercel dev`, or add these in Vercel → Project → Settings → Environment Variables.

# Required
REDIS_URL=redis://default:password@host:port
TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token

# Optional
OPENROUTER_API_KEY=          # enables "create reminder from text/voice"
OPENROUTER_MODEL=openrouter/auto
CRON_SECRET=                 # if set, /api/cron needs "Authorization: Bearer <secret>" or ?secret=<secret>
TELEGRAM_WEBHOOK_SECRET=     # default: derived from the bot token and registered automatically by the cron
VAPID_PUBLIC_KEY=            # default: generated once and stored in Redis
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=               # default: https://<your-domain>

# Support / monetization (all optional; see docs/MONETIZATION.md)
DONATE_USDT_TRC20=           # your Tron address (T...); donations here are verified automatically and give a 💎 supporter badge
DONATE_TON=                  # your TON address (TON and USDT on TON)
DONATE_USDT_BEP20=           # your BNB Chain address (0x...)
SUPPORTER_MIN_USDT=2         # minimum TRC20 donation that grants the badge
TRONGRID_API_KEY=            # optional, raises TronGrid rate limits
DONATE_STARS=                # "off" hides Telegram Stars donations (on by default when the bot is configured)
DONATE_STARS_AMOUNTS=50,150,500
ADS_AADS_UNIT=               # A-ADS ad unit id (numbers only). Ads are not allowed on Vercel's Hobby plan: use Render or Vercel Pro
